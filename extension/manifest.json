{
  "manifest_version": 3,
  "name": "Дополнительные возможности для Ozon",
  "version": "1.0",
  "description": "Дополнительные возможности для Ozon: скрытие элементов, автозакрытие карточек, анулирование заказов и др.",
  "icons": { "48": "./gift.png", "96": "./gift.png" },
  "content_scripts": [
    {
      "matches": ["*://turbo-pvz.ozon.ru/*"],
      "js": [
        "index.js",
        "orders.js",
        "return.js",
        "receiving.js",
        "hide/hide.js",
        "hide/menu.js",
        "hide/notifications.js",
        "hide/returns.js"
      ],
      "css": ["index.css", "hide/hide.css"]
    }
  ]
}
