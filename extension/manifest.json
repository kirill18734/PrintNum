{
  "manifest_version": 3,
  "name": "PrintNum",
  "description": "Полезные инструменты для turbo-pvz.ozon.ru: печать ячеек, автоскрипты, удобная автоматизация по QR-кодам и другое.",
  "version": "2.0.11",
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "96": "assets/icons/96.png",
    "128": "assets/icons/128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "https://printnum.s3.cloud.ru/*"],

  "action": {
    "default_title": "PrintNum",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },

  "content_scripts": [
    {
      "matches": ["https://turbo-pvz.ozon.ru/*"],
      "js": [
        "src/content/shared/config.js",
        "src/content/shared/storage.js",
        "src/content/shared/dom.js",
        "src/content/shared/api.js",
        "src/content/shared/navigation.js",
        "src/content/shared/keyboard.js",
        "src/content/shared/storage-events.js",
        "src/content/index.js",
        "src/content/features/qr-codes/handler.js",
        "src/content/features/printing/send-print-number.js",
        "src/content/features/printing/send-ozon-shelf.js",
        "src/content/features/banners/hide-banner.js",
        "src/content/features/navigation/hide-menu-notification.js",
        "src/content/features/navigation/hide-returns.js",
        "src/content/features/autoscripts/box.js",
        "src/content/features/autoscripts/package.js",
        "src/content/features/navigation/confirm-on-enter.js"
      ]
    }
  ]
}
