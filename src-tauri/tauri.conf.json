{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintNum",
  "version": "2.0.0",
  "identifier": "PrintNum",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Печать ячеек",
        "fullscreen": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "width": 450,
        "height": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/output/backend.exe": "./backend.exe",
      "../extension/.output/chrome-mv3": "extension",
      "../DriverPrinter_CHITENG-CT221B.exe": "./DriverPrinter_CHITENG-CT221B.exe"
    },
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxOTczNTQ3RUJEMDQ0NTYKUldSV1JORHJSeldYUWJmYmI2eHB0ZGlPaWZhQ2tWWjgrTEszSzBSb3JLSnppenMrYUpaemQwK1cK",
      "endpoints": ["https://printnum-kirill123451.amvera.io/latest.json"]
    }
  }
}
